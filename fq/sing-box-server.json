{
    "log": {
        "disabled": false,
        "level": "info",
        "output": "box.log",
        "timestamp": true
    },
    "dns": {
        "servers": [
            {
                "tag": "cf4",
                "type": "tls",
                "server": "1.1.1.1"
            },
            {
                "tag": "cf6",
                "type": "tls",
                "server": "2606:4700:4700::1111"
            },
            {
                "tag": "google4",
                "type": "tls",
                "server": "8.8.8.8"
            },
            {
                "tag": "google6",
                "type": "tls",
                "server": "2001:4860:4860::8888"
            }
        ]
    },
    "route": {
        "default_domain_resolver": {
            "server": "cf4",
            "strategy": "prefer_ipv4"
        },
        "final": "outbound-direct",
        "rules": [
            {
                "outbound": "outbound-direct",
                "domain_suffix": [
                    "gstatic.com",
                    "ampproject.org",
                    "gvt1.com",
                    "gvt2.com",
                    "google.cn",
                    "googleapis.cn",
                    "googleusercontent.com",
                    "ggpht.com",
                    "googlevideo.com",
                    "ytimg.com",
                    "gs-loc-cn.apple.com"
                ]
            },
            {
                "outbound": "outbound-direct",
                "domain_suffix": [
                    "atigrpulse.com",
                    "atigrzen.com",
                    "etasphere.com",
                    "ftfast.com",
                    "gotigerhk.com",
                    "iotaskyt.com",
                    "iotaskyty.com",
                    "itiger-nz.com",
                    "itiger.com",
                    "itigergrowth.com",
                    "itigergrowtha.com",
                    "itigertrader.com",
                    "itigerup.com",
                    "laohu8.com",
                    "play-analytics.com",
                    "skytigris.cn",
                    "skytigris.com",
                    "thetigerbrokers.com",
                    "tigerbbs.cn",
                    "tigerbbs.com",
                    "tigerbrokers.com",
                    "tigerbrokers.com.au",
                    "tigerbrokers.com.hk",
                    "tigerbrokers.com.sg",
                    "tigerbrokers.nz",
                    "tigeresop.com",
                    "tigeresop.com.sg",
                    "tigerfintech.com",
                    "tigerhkgo.com",
                    "tigersecurities.com",
                    "tigertrader.app",
                    "tigr.link",
                    "tigrdw.com",
                    "tigrgood.com",
                    "tigrwd.com",
                    "tradeup.com",
                    "ttm.financial",
                    "xiaohu8.com",
                    "zhijianfengyi.cn",
                    "zhijianfengyi.com"
                ]
            },
            {
                "outbound": "block",
                "ip_is_private": true
            },
            {
                "outbound": "block",
                "rule_set": [
                    "geoip-cn",
                    "geosite-cn"
                ]
            }
        ],
        "rule_set": [
            {
                "tag": "geoip-cn",
                "type": "remote",
                "format": "binary",
                "url": "https://raw.githubusercontent.com/SagerNet/sing-geoip/rule-set/geoip-cn.srs",
                "download_detour": "outbound-direct",
                "update_interval": "7d"
            },
            {
                "tag": "geosite-cn",
                "type": "remote",
                "format": "binary",
                "url": "https://raw.githubusercontent.com/SagerNet/sing-geosite/rule-set/geosite-cn.srs",
                "download_detour": "outbound-direct",
                "update_interval": "7d"
            }
        ]
    },
    "experimental": {
        "cache_file": {
            "enabled": true
        }
    },
    "inbounds": [
        {
            "type": "vless",
            "tag": "vless-in",
            "listen": "::1",
            "listen_port": 5443,
            "users": [
                {
                    "uuid": "TODO_REPLACE_THIS",
                    "flow": "xtls-rprx-vision"
                },
                {
                    "uuid": "TODO_REPLACE_THIS",
                    "flow": "xtls-rprx-vision"
                }
            ],
            "tls": {
                "enabled": true,
                "server_name": "TODO_REPLACE_THIS",
                "reality": {
                    "enabled": true,
                    "handshake": {
                        "server": "TODO_REPLACE_THIS",
                        "server_port": 443
                    },
                    "private_key": "TODO_REPLACE_THIS",
                    "short_id": [
                        "TODO_REPLACE_THIS"
                    ],
                    "max_time_difference": "1m"
                }
            }
        }
    ],
    "outbounds": [
        {
            "type": "direct",
            "tag": "outbound-direct"
        },
        {
            "type": "block",
            "tag": "block"
        }
    ]
}
